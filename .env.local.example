# MongoDB connection string (include the database name in the path)
MONGODB_URI=mongodb+srv://user:pass@cluster.example.mongodb.net/your-db-name

# Shared staff password for the login page
APP_PASSWORD=change-me

# Random long string used to sign the auth cookie
AUTH_SECRET=replace-with-a-long-random-string

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
